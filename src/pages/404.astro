---
import Base from '../layouts/Base.astro';
---
<Base title="찾을 수 없음">
  <div class="wrap narrow">
    <header class="page-head">
      <p class="eyebrow">404</p>
      <h1>이 페이지는 없습니다.</h1>
      <p class="lede">주소가 바뀌었거나 아직 쓰지 않은 글일 수 있습니다. <a href="/" style="color:var(--ink);border-bottom:1px solid var(--linen)">처음으로</a></p>
    </header>
  </div>
</Base>
